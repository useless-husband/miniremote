<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.john.miniremote</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/MiniRemote/MiniRemote.app/Contents/MacOS/MiniRemote</string>
    <string>--config</string>
    <string>__HOME__/MiniRemote/config.json</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/MiniRemote.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/MiniRemote.log</string>
</dict>
</plist>
